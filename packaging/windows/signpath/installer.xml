<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "installer": the Inno Setup installer, built from the
  already signed programs. Paste into SignPath (Project "perch" > Artifact configurations)
  under the slug "installer".
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" />
  </parameters>
  <zip-file>
    <pe-file path="Perch-setup.exe" product-name="Perch" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
