<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Perch.App.App"
             Name="Perch"
             RequestedThemeVariant="Default">

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Perch/Theme/Styles.axaml" />
  </Application.Styles>

  <!-- The macOS application menu. Without one, Avalonia offers "About Avalonia" there. -->
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="About Perch" Click="OnAbout" />
    </NativeMenu>
  </NativeMenu.Menu>
</Application>
