<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Perch.App.Controls"
        xmlns:vm="using:Perch.App.ViewModels"
        x:Class="Perch.App.Views.ScheduleWindow"
        x:DataType="vm:ScheduleViewModel"
        Title="Schedule"
        Width="720"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="TextBox.cell">
      <Setter Property="Width" Value="60" />
      <Setter Property="Height" Value="32" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="Padding" Value="4,0" />
    </Style>

    <!-- The schedule type: two big cards that act as one choice. -->
    <Style Selector="RadioButton.choice">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="frame" Background="{DynamicResource Perch.Surface}" BorderBrush="{DynamicResource Perch.Border}"
                  BorderThickness="2" CornerRadius="12" Padding="14,12">
            <ContentPresenter Content="{TemplateBinding Content}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.choice:pointerover /template/ Border#frame">
      <Setter Property="BorderBrush" Value="{DynamicResource Perch.AccentBright}" />
    </Style>
    <Style Selector="RadioButton.choice:checked /template/ Border#frame">
      <Setter Property="Background" Value="{DynamicResource Perch.AccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Perch.Accent}" />
    </Style>
    <Style Selector="RadioButton.choice:checked Border.badge">
      <Setter Property="Background" Value="{DynamicResource Perch.Surface}" />
    </Style>
    <Style Selector="RadioButton.choice c|Glyph.tick">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="RadioButton.choice:checked c|Glyph.tick">
      <Setter Property="IsVisible" Value="True" />
    </Style>


    <!-- The columns that belong to the chosen type sit on a tinted band, which pulses
         when the type changes so the eye goes to what just changed. -->
    <Style Selector="Border.band">
      <Setter Property="Background" Value="{DynamicResource Perch.AccentSoft}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.3" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.band.flash">
      <Setter Property="Background" Value="{DynamicResource Perch.AccentBright}" />
    </Style>

    <Style Selector="TextBlock.column">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Perch.TextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.column.mode">
      <Setter Property="Foreground" Value="{DynamicResource Perch.Accent}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <StackPanel Margin="22,18,22,20">
    <TextBlock Classes="title" Text="Schedule" />
    <Grid ColumnDefinitions="*,12,*" Margin="0,14,0,0">
      <RadioButton Classes="choice" GroupName="mode" IsChecked="{Binding IsRotation}"
                   AutomationProperties.Name="Rotate sitting and standing">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Classes="badge">
            <c:Glyph Kind="rotate" Width="20" Height="20" Foreground="{DynamicResource Perch.Accent}" />
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" Spacing="2">
            <TextBlock Classes="strong" Text="Rotate sitting and standing" />
            <TextBlock Classes="caption" TextWrapping="Wrap" Text="Sit for a while, stand for a while, repeat." />
          </StackPanel>
          <c:Glyph Grid.Column="2" Classes="tick" Kind="check" Width="18" Height="18" VerticalAlignment="Top"
                   Foreground="{DynamicResource Perch.Accent}" />
        </Grid>
      </RadioButton>
      <RadioButton Grid.Column="2" Classes="choice" GroupName="mode" IsChecked="{Binding IsHourly}"
                   AutomationProperties.Name="Stand every hour">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Classes="badge">
            <c:Glyph Kind="clock" Width="20" Height="20" Foreground="{DynamicResource Perch.Accent}" />
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" Spacing="2">
            <TextBlock Classes="strong" Text="Stand every hour" />
            <TextBlock Classes="caption" TextWrapping="Wrap" Text="Up at the same minute past each hour." />
          </StackPanel>
          <c:Glyph Grid.Column="2" Classes="tick" Kind="check" Width="18" Height="18" VerticalAlignment="Top"
                   Foreground="{DynamicResource Perch.Accent}" />
        </Grid>
      </RadioButton>
    </Grid>
    <TextBlock Classes="caption" TextWrapping="Wrap" Margin="2,10,0,16" Text="{Binding Explanation}" />

    <Border Classes="card" Padding="16,10">
      <!-- Same columns as each row, so the band behind columns 3-4 lines up with them. -->
      <Grid ColumnDefinitions="148,72,72,72,72,74,74,*" RowDefinitions="Auto,Auto,Auto">
        <Border Name="ModeBand" Classes="band" Grid.Column="3" Grid.ColumnSpan="2" Grid.RowSpan="3"
                Margin="0,0,0,4" />

        <StackPanel Grid.Column="3" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6"
                    HorizontalAlignment="Center" Margin="0,8,0,0">
          <c:Glyph Kind="{Binding ModeGlyph}" Width="14" Height="14" Foreground="{DynamicResource Perch.Accent}" />
          <TextBlock Classes="column mode" Text="{Binding ModeName}" />
        </StackPanel>

        <!-- Column headings, on the same grid as the rows below. -->
        <Grid Grid.Row="1" Grid.ColumnSpan="8" ColumnDefinitions="148,72,72,72,72,74,74,*" Height="30">
          <TextBlock Classes="column" Text="Day" />
          <TextBlock Grid.Column="1" Classes="column" Text="From" />
          <TextBlock Grid.Column="2" Classes="column" Text="Until" />
          <TextBlock Grid.Column="3" Classes="column mode" Text="Stand at" IsVisible="{Binding IsHourly}" />
          <TextBlock Grid.Column="4" Classes="column mode" Text="For (min)" IsVisible="{Binding IsHourly}" />
          <TextBlock Grid.Column="3" Classes="column mode" Text="Sit (min)" IsVisible="{Binding IsRotation}" />
          <TextBlock Grid.Column="4" Classes="column mode" Text="Stand (min)" IsVisible="{Binding IsRotation}" />
          <TextBlock Grid.Column="5" Classes="column" Text="Stand cm" />
          <TextBlock Grid.Column="6" Classes="column" Text="Return cm" />
        </Grid>

        <ItemsControl Grid.Row="2" Grid.ColumnSpan="8" ItemsSource="{Binding Days}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DayRow">
              <StackPanel>
                <Border Classes="rule" />
                <Grid ColumnDefinitions="148,72,72,72,72,74,74,*" Height="44">
                  <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <ToggleSwitch IsChecked="{Binding Enabled}" OnContent="" OffContent="" MinWidth="0"
                                  AutomationProperties.Name="{Binding Name}" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBox Grid.Column="1" Classes="cell" Text="{Binding From}" IsEnabled="{Binding Enabled}"
                           LostFocus="OnFieldLeft" />
                  <TextBox Grid.Column="2" Classes="cell" Text="{Binding Until}" IsEnabled="{Binding Enabled}"
                           LostFocus="OnFieldLeft" />
                  <TextBox Grid.Column="3" Classes="cell" Text="{Binding StandAt}" IsEnabled="{Binding Enabled}"
                           IsVisible="{Binding $parent[ItemsControl].((vm:ScheduleViewModel)DataContext).IsHourly}"
                           LostFocus="OnFieldLeft" />
                  <TextBox Grid.Column="4" Classes="cell" Text="{Binding StandFor}" IsEnabled="{Binding Enabled}"
                           IsVisible="{Binding $parent[ItemsControl].((vm:ScheduleViewModel)DataContext).IsHourly}"
                           LostFocus="OnFieldLeft" />
                  <TextBox Grid.Column="3" Classes="cell" Text="{Binding RotationSit}" IsEnabled="{Binding Enabled}"
                           IsVisible="{Binding $parent[ItemsControl].((vm:ScheduleViewModel)DataContext).IsRotation}"
                           LostFocus="OnFieldLeft" />
                  <TextBox Grid.Column="4" Classes="cell" Text="{Binding RotationStand}" IsEnabled="{Binding Enabled}"
                           IsVisible="{Binding $parent[ItemsControl].((vm:ScheduleViewModel)DataContext).IsRotation}"
                           LostFocus="OnFieldLeft" />
                  <TextBox Grid.Column="5" Classes="cell" Text="{Binding StandCm}" IsEnabled="{Binding Enabled}"
                           LostFocus="OnFieldLeft" />
                  <TextBox Grid.Column="6" Classes="cell" Text="{Binding SitCm}" IsEnabled="{Binding Enabled}"
                           LostFocus="OnFieldLeft" />
                  <Button Grid.Column="7" Classes="subtle quiet" Height="30" Padding="8,0"
                          HorizontalAlignment="Right" Click="OnCopy">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <c:Glyph Kind="copy" Width="13" Height="13" />
                      <TextBlock Text="Copy" />
                    </StackPanel>
                  </Button>
                </Grid>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>

    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,18,0,0">
      <TextBlock Classes="caption" Text="{Binding Error}" Foreground="{DynamicResource Perch.Danger}"
                 VerticalAlignment="Center" TextWrapping="Wrap" />
      <Button Grid.Column="1" Classes="primary" Width="104" Height="36" Margin="0,0,8,0" IsDefault="True"
              Click="OnSave" Content="Save" />
      <Button Grid.Column="2" Width="104" Height="36" IsCancel="True" Click="OnCancel" Content="Cancel" />
    </Grid>
  </StackPanel>
</Window>
