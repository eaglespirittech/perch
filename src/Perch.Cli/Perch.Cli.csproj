<Project Sdk="Microsoft.NET.Sdk">

  <!--
    perch-cli, for Windows and macOS from one source. The desk logic comes from
    Perch.Core; Perch.Platform supplies the OS half for whichever target is built:

      dotnet publish src/Perch.Cli -f net9.0-windows10.0.19041.0 -r win-x64
      dotnet publish src/Perch.Cli -f net9.0 -r osx-arm64
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(PerchWindowsTfm);$(PerchPortableTfm)</TargetFrameworks>
    <AssemblyName>perch-cli</AssemblyName>
    <RootNamespace>Perch.Cli</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == '$(PerchWindowsTfm)'">
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Perch.Core\Perch.Core.csproj" />
    <ProjectReference Include="..\Perch.Platform\Perch.Platform.csproj" />
  </ItemGroup>

</Project>
