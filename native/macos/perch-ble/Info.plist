<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Linked into the perch-ble binary itself (see build.sh). macOS terminates any process
  that touches CoreBluetooth without a usage description, and a bare command line
  binary has no bundle to carry one.
-->
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.eaglespirit.perch.ble</string>
    <key>CFBundleName</key>
    <string>perch-ble</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Perch uses Bluetooth to move your desk.</string>
</dict>
</plist>
