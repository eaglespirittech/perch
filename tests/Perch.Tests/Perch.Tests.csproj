<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Plain console app rather than a test framework: the shared core has no dependencies,
    and the exit code (number of failed checks) is all CI needs. Runs on every OS, since
    it only touches Perch.Core; the desk tests use the simulated desk.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>Perch.Tests</AssemblyName>
    <RootNamespace>Perch.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Perch.Core\Perch.Core.csproj" />
  </ItemGroup>

</Project>
