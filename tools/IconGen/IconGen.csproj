<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Regenerates assets/perch.ico (Windows) and assets/perch.icns (macOS) from the same
    geometry the app draws its icon with at runtime. Runs on either OS.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>IconGen</AssemblyName>
    <RootNamespace>Perch.Tools</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The version Avalonia's own renderer uses. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Perch.App\Controls\AppIconShape.cs" Link="AppIconShape.cs" />
  </ItemGroup>

</Project>
