<Project Sdk="Microsoft.NET.Sdk">

  <!-- Regenerates assets/perch.ico from the drawing code the app uses at runtime. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>IconGen</AssemblyName>
    <RootNamespace>Perch.Tools</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Ui\AppIcon.cs" Link="AppIcon.cs" />
    <Compile Include="..\..\Ui\Theme.cs" Link="Theme.cs" />
  </ItemGroup>

</Project>
