<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>perch-cli</AssemblyName>
    <RootNamespace>Perch.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared with the app rather than reimplemented, so the two cannot drift. -->
    <Compile Include="..\DeskController.cs" Link="DeskController.cs" />
    <Compile Include="..\Settings.cs" Link="Settings.cs" />
    <Compile Include="..\Schedule.cs" Link="Schedule.cs" />
    <Compile Include="..\Ipc\ControlProtocol.cs" Link="ControlProtocol.cs" />
  </ItemGroup>

</Project>
